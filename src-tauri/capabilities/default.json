{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema/capability.json",
  "identifier": "default",
  "description": "Default capability set for Scrcpy Launcher",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "scrcpy",
          "cmd": "scrcpy",
          "args": true
        },
        {
          "name": "adb",
          "cmd": "adb",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "scrcpy",
          "cmd": "scrcpy",
          "args": true
        },
        {
          "name": "adb",
          "cmd": "adb",
          "args": true
        }
      ]
    }
  ]
}
